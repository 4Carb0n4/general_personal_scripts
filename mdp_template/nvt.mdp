; NVT 平衡

; run
integrator              = md        ; 
dt                      = 0.001     ; 1 fs
nsteps                  = 500000     ; 1 * 500000 = 500 ps

; output 
nstenergy               = 1000       ; 500_000/2000 = 250 帧数据
nstlog                   = 2000
nstxout-compressed       = 2000   

; neighbor searching
cutoff-scheme = Verlet
nstlist                 = 20  
pbc                     = xyz

; Electrostatics
coulombtype             = PME       
rcoulomb                = 1.2

; van der Waals 
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres

; NVT
; 温度
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 1.0
ref-t                    = 298.15
; 压力
pcoupl                  = no

; 生成速度
continuation  = no 
gen-vel                  = yes
gen-temp                 = 298.15

;bonds 
constraint-algorithm     = lincs
constraints              = none





