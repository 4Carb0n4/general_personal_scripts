; 第一步NPT
; --- 运行控制 ---
integrator               = md
dt                       = 0.001        ; h-bonds 2 fs
nsteps                   = 2000000       ; 0.001*2_000_000=2ns
continuation             = yes          ; 从 NVT 衔接，继承速度和坐标

; --- 输出控制 ---
nstenergy                = 20000          ; 2_000_000/20000=100 帧数据
nstlog                   = 20000          ; 2_000_000/20000=100    帧数据 
nstxout-compressed       = 10000          ; 2_000_000/10000=200   帧数据 

; --- 约束控制，不约束 ---
constraints              = none    
constraint-algorithm     = lincs


; --- 相互作用 ---
cutoff-scheme            = Verlet

; gmx note: increase nstlist to improve performance
nstlist                  = 100
coulombtype              = PME
rcoulomb                 = 1.0
rvdw                     = 1.0
vdwtype                  = cut-off 
DispCorr                 = EnerPres     ; 必须开启，以修正长程范德华力对压力的影响


; --- 温度耦合组配置 ---
tcoupl              = v-rescale             ; 推荐算法，动力学较准确且稳定
tc-grps             = System                ; 这里的名字必须在 index.ndx 中存在
tau-t               = 1.0            
ref-t               = 298.15        

; --- 压力耦合 (NPT 核心) ---
pcoupl                   = c-rescale    ;快速稳定,先不用pr
pcoupltype               = isotropic
tau_p                    = 5.0          ; default 5.0 ps
ref_p                    = 1.0          ; 1.0 bar
compressibility          = 4.5e-5       ; 水的压缩率
