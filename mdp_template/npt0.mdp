; NPT 平衡

; run
integrator              = md        
dt                      = 0.001     ; 1 fs
nsteps                  = 20000000     ; 20ns,20_000_000*0.001=20ns

; output 
nstenergy               = 5000       ; 20_000_000/5000 = 4000 帧数据
nstlog                   = 5000
nstxout-compressed       = 10000   ; 20_000_000/10000 = 2000 帧数据

; neighbor searching
cutoff-scheme           = Verlet
nstlist                 = 20  
pbc                     = xyz

; Electrostatics
coulombtype             = PME       
rcoulomb                = 1.2

; van der Waals 
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres

; NPT
; 温度
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 1.0
ref-t                    = 298.15
; --- 压力耦合 (NPT 核心) ---
pcoupl                   = c-rescale 
pcoupltype               = isotropic
tau_p                    = 5.0          ; default 5.0 ps
ref_p                    = 1.0          ; 1.0 bar
compressibility          = 4.5e-5       ; 水的压缩率

; 生成速度
continuation             = yes          ; 从 NVT 衔接，继承速度和坐标
gen-vel                  = no

;bonds 
constraint-algorithm     = lincs
constraints              = none