; 第二步npt，同时是prdrun
; --- 运行控制 ---
integrator               = md
dt                       = 0.002        ; h-bonds 2 fs
nsteps                   = 5000000       ; 0.002*5,000,000=10ns
continuation             = yes          ; 从 NVT 衔接，继承速度和坐标

; --- 输出控制 ---
nstenergy                = 20000          ; 5,000,000/12500 = 400   帧数据
; nstcalcenergy            = 5000           ; 采用 default 100
; nstcomm                  = 5000           ; 采用默认值 default 100
nstlog                   = 20000          ; 5,000,000/12500=400   帧log 
nstxout-compressed       = 12500          ; 5,000,000/12500=400   帧数据 


; --- 约束控制 ---
constraints              = h-bonds    
constraint-algorithm     = lincs

; --- 相互作用优化版 ---
cutoff-scheme            = Verlet
nstlist                  = 80           ; 现代 GPU 建议设为 40 甚至 80，gmx 会自动平衡
coulombtype              = PME          ; 静电 PME，GPU 支持完美
rcoulomb                 = 1.0
vdwtype                  = Cut-off      ; 修改这里：从 PME 改为 Cut-off
vdw-modifier             = Force-switch ; 增加平滑切换，避免力的跳变
rvdw-switch              = 0.8          ; 从 0.8 nm 开始力平滑降至 0
rvdw                     = 1.0          ; 截断半径
DispCorr                 = EnerPres     ; 保留，修正压力误差

; ; --- 相互作用 ---
; cutoff-scheme            = Verlet
; ; gmx note: increase nstlist to improve performance
; nstlist                  = 20
; coulombtype              = PME
; rcoulomb                 = 1.0
; rvdw                     = 1.0
; vdwtype                  = PME 
; DispCorr                 = EnerPres     ; 必须开启，以修正长程范德华力对压力的影响


; --- 温度耦合组配置 ---
tcoupl              = v-rescale             ;  加速
tc-grps             = non-Water  Water      ; 这里的名字必须在 index.ndx 中存在
tau-t               = 1.0      1.0          ; 
ref-t               = 298.15   298.15       ; 对应两个组的目标温度 (K)

; --- 压力耦合 (NPT 核心) ---
pcoupl                   = Parrinello-Rahman 
pcoupltype               = isotropic
tau_p                    = 5.0          ; default 5.0 ps
ref_p                    = 1.0          ; 1.0 bar
compressibility          = 4.5e-5       ; 水的压缩率
